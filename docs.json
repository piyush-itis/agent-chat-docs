{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Galaxy Agent Chat",
  "logo": { "light": "/logo.svg", "dark": "/logo.svg" },
  "favicon": "/favicon.svg",
  "colors": {
    "primary": "#6D5EF7",
    "light": "#F4F4F5",
    "dark": "#0B0B0F"
  },
  "api": {
    "openapi": "openapi.yaml",
    "playground": {
      "display": "interactive"
    },
    "mdx": {
      "server": "https://agent-chat-backend.vercel.app",
      "auth": {
        "method": "bearer"
      }
    }
  },
  "navigation": {
    "groups": [
      {
        "group": "Guides",
        "pages": ["index", "authentication", "runs", "webhooks", "errors"]
      },
      {
        "group": "Tools",
        "pages": ["tools"]
      },
      {
        "group": "API playground",
        "pages": [
          "api/list-chats",
          "api/create-chat",
          "api/list-messages",
          "api/send-turn",
          "api/completions",
          "api/run-tool",
          "api/get-run",
          "api/resume-waitpoint"
        ]
      }
    ]
  }
}
